# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/gymio

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Public URL of this server (used for Tranzak callback/return URLs, email links, QR codes)
APP_URL=https://app.myfiti.app

# Allowed browser origin(s) for CORS — comma-separated if multiple
CORS_ORIGIN=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Strong random secret — generate with: openssl rand -hex 64
JWT_SECRET=change_me_generate_with_openssl_rand_hex_64

# ─── Redis / BullMQ ───────────────────────────────────────────────────────────
# Option 1: full Redis URL (preferred)
REDIS_URL=redis://localhost:6379

# Option 2: individual parts (used if REDIS_URL is not set)
# BULLMQ_REDIS_HOST=localhost
# BULLMQ_REDIS_PORT=6379
# BULLMQ_REDIS_PASSWORD=

# Upstash Redis (optional — used for rate limiting only; falls back to in-memory if unset)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Email (Brevo / Sendinblue) ────────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=no-reply@myfiti.app

# Support email for outbound staff invite / support messages
# SUPPORT_EMAIL=support@myfiti.app

# ─── Tranzak (Mobile Money Payments) ──────────────────────────────────────────
# Platform-level Tranzak credentials (myfiti billing + fallback for gyms without own creds)
TRANZAK_APP_ID=your_tranzak_app_id
TRANZAK_APP_KEY=your_tranzak_app_key

# Set to 'live' for production, anything else uses sandbox
TRANZAK_ENV=sandbox

# Webhook secret for verifying Tranzak webhook signatures
TRANZAK_WEBHOOK_SECRET=your_tranzak_webhook_secret

# ─── Secret encryption key (AES-256-GCM) ──────────────────────────────────────
# Used to encrypt sensitive secrets (e.g. per-tenant tranzak_app_secret) stored in DB.
# Generate with: openssl rand -hex 32
# REQUIRED in production. Without this, tenant secrets are stored as plain-text.
SECRET_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# ─── Africa's Talking SMS (optional — day pass receipts) ──────────────────────
# AT_API_KEY=your_africastalking_api_key
# AT_USERNAME=sandbox
# AT_SENDER_ID=myfiti

# ─── WhatsApp Cloud API (optional) ────────────────────────────────────────────
# WHATSAPP_TOKEN=your_whatsapp_access_token
# WHATSAPP_PHONE_ID=your_phone_number_id

# ─── Logging ──────────────────────────────────────────────────────────────────
# Set to 'debug' to enable verbose request/response logging
# LOG_LEVEL=debug
