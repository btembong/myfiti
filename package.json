{
  "name": "gymflow",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:tenant": "tsx scripts/migrate.ts --tenant"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}
