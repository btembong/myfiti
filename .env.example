# ─── App ───────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=https://app.gymflow.app
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Database (Neon PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/gymflow
DB_POOL_MAX=10

# ─── Cache (Upstash Redis) ─────────────────────────────────────────
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Payments (Tranzak) ────────────────────────────────────────────
PAYMENT_PROVIDER=tranzak          # tranzak | (v2: mobile_money)
TRANZAK_APP_ID=
TRANZAK_APP_SECRET=
TRANZAK_WEBHOOK_SECRET=
TRANZAK_ENV=sandbox               # sandbox | live

# ─── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@gymflow.app

# ─── SMS (Africa's Talking) ────────────────────────────────────────
# https://account.africastalking.com → Settings → API Key
# AT_USERNAME=sandbox for testing, your shortcode for production
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=myfiti

# ─── Tranzak webhook signing secret ────────────────────────────────
TRANZAK_WEBHOOK_SECRET=

# ─── SuperAdmin JWT (separate secret for superadmin portal) ────────
SUPERADMIN_JWT_SECRET=

# ─── Push Notifications (Expo) ─────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── File Storage (Cloudflare R2) ──────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=gymflow-media
R2_PUBLIC_URL=https://media.gymflow.app

# ─── Cloudflare (CDN + subdomains) ────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
